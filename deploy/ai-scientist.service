[Unit]
Description=AI Scientist FastAPI server
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/ai_scientist
Environment=PYTHONIOENCODING=utf-8
Environment=AI_LOG_DIR=/opt/ai_scientist/data/runs
ExecStart=/opt/ai_scientist/.venv/bin/gunicorn -k uvicorn.workers.UvicornWorker -w 1 -b 127.0.0.1:8000 src.api_fastapi:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
